{
  "name": "sitemap-compare",
  "dependencies": {
    "cypress": "^13.15.2",
    "cypress-image-diff-html-report": "^2.2.0",
    "cypress-image-diff-js": "^2.3.0",
    "cypress-wait-until": "^3.0.2",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "compare": "npm-run-all -s -c run-compare http",
    "run-spec": "DISPLAY='' NODE_OPTIONS='' cypress run --spec=$spec",
    "update-baseline-images": "npx cypress-image-diff -u",
    "http": "npx http-server . -o cypress-image-diff-html-report/cypress-image-diff-html-report.html",
    "run-compare": "spec=cypress/e2e/compare.cy.js npm run run-spec",
    "clear": "rm cypress-image-diff-screenshots/baseline/* cypress-image-diff-screenshots/comparison/* cypress-image-diff-screenshots/diff/* cypress-image-diff-html-report/*",
    "generate-report": "cypress-image-diff-html-report generate",
    "display-report": "cypress-image-diff-html-report start"
  }
}
